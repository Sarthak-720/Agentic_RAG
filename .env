# Copy this file to `.env` for local development and fill in real values.
# Never commit the real `.env` file -- add it to .gitignore.
#
# On Streamlit Community Cloud, do NOT upload a .env file. Instead paste
# these same key=value pairs into your app's Settings -> Secrets box
# (TOML format works fine as KEY = "value").

# --- LLM provider: pick ONE of "openai", "gemini", "groq" ---
# You only need to set the API key for whichever provider you choose below.
# Gemini and Groq both have genuinely free tiers (no credit card required),
# which is why "gemini" is the default -- switch back to "openai" any time
# by changing this one line, no code changes needed.
LLM_PROVIDER=gemini

# --- OpenAI (only needed if LLM_PROVIDER=openai) ---
OPENAI_API_KEY="Enter your API Key here"

# --- Google Gemini (only needed if LLM_PROVIDER=gemini) ---
# Free tier: no credit card, ~1000+ requests/day on gemini-2.5-flash-lite.
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY="Enter your API Key here"
# --- Groq (only needed if LLM_PROVIDER=groq) ---
# Free tier: no credit card, very fast inference on open-weight models.
# Get a key at https://console.groq.com/keys
#GROQ_API_KEY=gsk_...

# --- Pinecone: cloud-managed serverless vector database (always required) ---
PINECONE_API_KEY="Enter your API Key here"
PINECONE_INDEX_NAME=crag-ops-10k-hf
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
TAVILY_API_KEY="Enter your API Key here"

